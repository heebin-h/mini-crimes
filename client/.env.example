# Mini Crimes — Client 환경변수
# 로컬 개발 시 이 파일을 .env.local로 복사: cp .env.example .env.local
# (Vite는 .env.local을 자동으로 읽고 git에서 제외됨)

# 서버 주소
# - 로컬 개발: 비워두면 vite.config.js 프록시가 localhost:3001로 중계
# - 배포 시: 실제 서버 URL로 교체
# VITE_SERVER_URL=https://mini-crimes-api.onrender.com
VITE_SERVER_URL=

# 빌드 base path
# - 로컬 개발: /
# - GitHub Pages 서브경로 배포: /mini-crimes/
# GitHub Actions secrets.VITE_BASE로도 주입 가능
VITE_BASE=/
