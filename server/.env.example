# Mini Crimes — Server 환경변수
# 이 파일을 복사해서 .env로 사용: cp .env.example .env

# 서버 포트 (Render/Railway 등은 자동 할당)
PORT=3001

# JWT 서명 키 — 프로덕션에서는 반드시 32자 이상 랜덤 문자열로 교체
# 예: openssl rand -hex 32
JWT_SECRET=minicrimessecret2025_교체하세요

# CORS 허용 Origin — 배포된 클라이언트 도메인으로 교체
# GitHub Pages 예시: https://username.github.io
CLIENT_URL=http://localhost:5173

# 프로덕션 모드에서 client/dist 정적 서빙 활성화
# NODE_ENV=production
